rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper Safe Get
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
             : {};
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().get('role', '') == 'Admin';
    }

    function isUserActive() {
      return isAuthenticated() && getUserData().get('status', '') == 'ACTIVE';
    }

    // --- Collection Rules ---

    // 1. Users
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow read, delete: if isAdmin();
    }

    // 2. Sites (ตรวจสอบจาก sites array ของ user แทน members array)
    match /sites/{siteId} {
      allow read: if isAuthenticated() && (
        siteId in getUserData().get('sites', []) ||
        isAdmin()
      );
      allow write: if isAdmin();

      // อนุญาตให้อ่าน Category ย่อยภายใน Site
      match /categories/{categoryId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
    
    // อนุญาต collectionGroup query สำหรับ categories (สำคัญสำหรับหน้า RFA list)
    match /{path=**}/categories/{categoryId} {
      allow read: if isAuthenticated();
    }

    // 3. RFA Documents & Work Requests
    //
    // CM only ever reads a document once it has actually reached them (roadmap T-008).
    // Unlike RFI, RFA never moves a document's status back to PENDING_REVIEW/
    // REVISION_REQUIRED once it reaches CM — a revision instead creates a brand-new
    // document — so a plain status whitelist is a safe permanent test, no sticky flag
    // needed. The dashboard's Firestore query must add
    // where('status','in',[...same list...]) for CM viewers, or this rule rejects the
    // whole list query. Keep this list in sync with RFA_CM_VISIBLE_STATUSES in
    // src/lib/config/workflow.ts (rules can't import JS, so it's duplicated here).
    match /rfaDocuments/{docId} {
      allow read: if isUserActive() && (
        getUserData().get('role', '') != 'CM' ||
        resource.data.status in [
          'PENDING_CM_APPROVAL', 'PENDING_FINAL_APPROVAL',
          'APPROVED', 'APPROVED_WITH_COMMENTS', 'APPROVED_REVISION_REQUIRED', 'REJECTED'
        ]
      );
      allow create, update: if isUserActive();
      allow delete: if isAdmin();
    }
    
    match /workRequests/{docId} {
      allow read, create, update: if isUserActive();
      allow delete: if isAdmin();
    }

    // RFI Documents (Request For Information)
    // Client reads this collection directly via onSnapshot on the RFI dashboard,
    // so it must be declared here or the catch-all deny at the bottom blocks it.
    //
    // CM only ever reads a document once it has actually reached them (roadmap T-007):
    // cmInvolved is a sticky flag set true the first time the document is forwarded to
    // CM and never reset back (see rfi/[id]/route.ts) — plain status/awaitingCm cannot
    // express this because CM_REPLY clears awaitingCm back to false. The dashboard's
    // Firestore query must add where('cmInvolved','==',true) for CM viewers, or this
    // rule rejects the whole list query.
    match /rfiDocuments/{docId} {
      allow read: if isUserActive() && (
        getUserData().get('role', '') != 'CM' || resource.data.get('cmInvolved', false) == true
      );
      allow create, update: if isUserActive();
      allow delete: if isAdmin();
    }

    // 4. Others
    match /constructionInfo/{docId} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }
    
    match /comments/{commentId} { 
        allow read, create: if isUserActive(); 
        allow update, delete: if isUserActive() && (isAdmin() || isOwner(resource.data.createdBy)); 
    }
    
    match /counters/{counterId} {
      allow read, write: if isUserActive();
    }

    match /invitations/{inviteId} {
      allow get: if true; 
      allow list, write: if isAdmin();
    }
    
    // ✅ 5. Activity Logs (เอามาไว้ตรงนี้)
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && (
        getUserData().get('role', '') in ['Admin', 'PM', 'PD']
      );
      allow write: if false; 
    }
    
    // ❌ บรรทัดนี้ควรอยู่ล่างสุดเสมอ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}